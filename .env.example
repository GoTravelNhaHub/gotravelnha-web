# Auth session cookie (at least 32 random characters, e.g. `openssl rand -hex 32`)
SESSION_PASSWORD=

# Trip planner (Claude API). Server-side only.
ANTHROPIC_API_KEY=
# Required when the API key is not scoped to one workspace. Console → Settings → Workspaces. Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gotravelnha

# Trip.com Crawler
TRIP_CRAWL_ENABLED=true
TRIP_ALLIANCE_ID=3883416
TRIP_SID=22874365

# Klook Crawler
KLOOK_CRAWL_ENABLED=true
KLOOK_AD_ID=your_klook_ad_id
KLOOK_AFFILIATE_ID=your_klook_ad_id

# Optional Crawler Settings
CRAWL_FULL=false
CRAWL_MAX_PAGES=5
KLOOK_CRAWL_TYPE=all
KLOOK_CRAWL_MAX_ITEMS=50
KLOOK_CRAWL_LOCATIONS=Singapore

# Affiliate conversion postbacks (/api/affiliate/postback). At least 16 random characters; leave empty to disable.
AFFILIATE_POSTBACK_SECRET=

# Public customer support email shown on contact, help and booking pages
NUXT_PUBLIC_SUPPORT_EMAIL=
