# www.gotravelnha.com (Nuxt). The backend lives in ../backend (api.gotravelnha.com); server secrets go there.

# Backend origin, no trailing slash. Local: http://localhost:3002
NUXT_PUBLIC_API_BASE=https://api.gotravelnha.com
# Admin app origin. Local: http://localhost:3001
NUXT_PUBLIC_ADMIN_URL=https://admin.gotravelnha.com
# This site's public origin. Local: http://localhost:3000
NUXT_PUBLIC_SITE_URL=https://www.gotravelnha.com

# Public customer support email shown on contact, help and booking pages
NUXT_PUBLIC_SUPPORT_EMAIL=

# Community pages and nav item (/community). Off unless set to true. Set the same value on the backend.
NUXT_PUBLIC_ENABLE_COMMUNITY=false

# Labelled sample trips and creators on /community, for design review only. Never in production.
NUXT_PUBLIC_COMMUNITY_DEMO=false
